<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.talented.buttie.account.mapper.AccountMapper">

  <select id="findActiveByUserId"
          resultType="com.talented.buttie.account.domain.AccountVO">
    select *
    from ACCOUNT
    where USER_ID = #{userId}
        and IS_ACTIVE = true
  </select>

</mapper>