<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.talented.buttie.snapshot.mapper.FinancialSnapshotMapper">

  <select id="findLatestByUserId"
          resultType="com.talented.buttie.snapshot.domain.FinancialSnapshotVO">
    select *
    from SNAPSHOT
    where USER_ID = #{userId}
    order by SNAPSHOT_BASE_DATE desc, SNAPSHOT_CREATED_AT desc
    limit 1
  </select>
</mapper>
